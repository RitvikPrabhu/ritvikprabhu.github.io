---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { date } from "../data/content";
interface Props {
  posts: CollectionEntry<"writing">[];
  filterable?: boolean;
}
const { posts, filterable = false } = Astro.props;
---

<div class="post-list">
  {posts.map((post) => (
    <article
      class:list={["post-row", { "with-thumbnail": post.data.thumbnail }]}
      data-filter-entry={filterable || undefined}
      data-filter-tags={JSON.stringify(post.data.tags)}
      data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")} ${date(post.data.published)}`.toLowerCase()}
    >
      <time datetime={post.data.published.toISOString()}>
        {date(post.data.published)}
      </time>
      <div>
        <h3>
          <a href={`/writing/${post.id}/`}>{post.data.title}</a>
        </h3>
        <p>{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <p class="post-tags">{post.data.tags.join(" · ")}</p>
        )}
      </div>
      {post.data.thumbnail ? (
        <a
          class="post-thumbnail"
          href={`/writing/${post.id}/`}
          tabindex="-1"
          aria-hidden="true"
        >
          <Image
            src={post.data.thumbnail.src}
            alt={post.data.thumbnail.alt}
            widths={[144, 288]}
            sizes="(max-width: 760px) 80px, 144px"
            width={288}
            height={162}
            loading="lazy"
          />
        </a>
      ) : (
        <span aria-hidden="true">↗</span>
      )}
    </article>
  ))}
</div>
