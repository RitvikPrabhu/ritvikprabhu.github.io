---
import Base from "../layouts/BaseLayout.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import Publication from "../components/Publication.astro";
import PostList from "../components/PostList.astro";
import { publications, writing } from "../data/content";
import { site } from "../data/site";
const all = await publications();
const selected = all.some((p) => p.data.selected)
  ? all.filter((p) => p.data.selected).slice(0, 3)
  : all.slice(0, 3);
const posts = (await writing()).slice(0, 3);
---

<Base>
  <section class="intro">
    <div>
      <p class="eyebrow">Research & writing</p>
      <h1>
        Hi, I’m <br />
        Ritvik<span class="accent">.</span>
      </h1>
    </div>
    <div class="intro-copy">
      <p>{site.introduction}</p>
      <ProfileLinks />
      <a class="text-link" href="/about/">
        More about me <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="home-section" aria-labelledby="publications-title">
    <div class="section-heading">
      <h2 id="publications-title">Selected publications</h2>
      <a class="text-link" href="/publications/">
        All publications <span aria-hidden="true">→</span>
      </a>
    </div>
    {selected.map((publication) => (
      <Publication publication={publication} compact />
    ))}
  </section>
  <section class="home-section" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">Latest writing</h2>
      <a class="text-link" href="/writing/">
        All writing <span aria-hidden="true">→</span>
      </a>
    </div>
    {posts.length ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty-state">
        No articles published yet. Future technical and research writing will
        appear here.
      </p>
    )}
  </section>
</Base>
