---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import Base from "../layouts/BaseLayout.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { site } from "../data/site";
import {
  research,
  internships,
  education,
  honors,
  service,
} from "../data/experience";
import news from "../data/news.json";
---

<Base title="About" description={site.about[0]}>
  <div class="page-heading">
    <p class="eyebrow">A little background</p>
    <h1>
      About<span class="accent">.</span>
    </h1>
  </div>
  <section class="about-intro" aria-label="Introduction">
    <Image
      class="portrait"
      src={portrait}
      alt="Ritvik Prabhu"
      widths={[230, 460]}
      sizes="(max-width: 480px) 180px, (max-width: 760px) 150px, 230px"
      width={460}
      height={560}
      loading="eager"
    />
    <div class="about-copy">
      {site.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p class="location">{site.location}</p>
      <ProfileLinks />
    </div>
  </section>
  {[
    { title: "Research", entries: research },
    { title: "Internships", entries: internships },
  ].map((section) => (
    <section class="cv-section">
      <h2>{section.title}</h2>
      <div>
        {section.entries.map((entry) => (
          <article class="experience">
            <p class="dates">{entry.dates}</p>
            <h3>
              {entry.url ? (
                <a href={entry.url}>{entry.organization} ↗</a>
              ) : (
                entry.organization
              )}
            </h3>
            <p class="role">{entry.role}</p>
            <p class="location">{entry.location}</p>
            <p class="summary">{entry.summary}</p>
            <ul>
              {entry.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  ))}
  <section class="cv-section">
    <h2>Education</h2>
    <div>
      {education.map((entry) => (
        <article class="experience">
          <p class="dates">{entry.date}</p>
          <h3>{entry.degree}</h3>
          <p class="role">Virginia Tech</p>
          <p class="location">
            {site.location} · Cumulative GPA: {entry.gpa}
          </p>
          <p class="summary">{entry.details}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="cv-section">
    <h2>Awards & recognition</h2>
    <div>
      {honors.map((entry) => (
        <article class="experience">
          {entry.date && <p class="dates">{entry.date}</p>}
          <h3>{entry.title}</h3>
          <p class="summary">{entry.description}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="cv-section">
    <h2>Professional service</h2>
    <div>
      {service.map((entry) => (
        <article class="experience">
          <p class="dates">{entry.year}</p>
          <h3>{entry.role}</h3>
          <p class="role">{entry.venue}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="cv-section">
    <h2>News & highlights</h2>
    <div>
      {news.map((item) => (
        <div class="news-row">
          <time>{item.date}</time>
          <p>{item.title}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
