---
import { Image } from "astro:assets";
import portrait from "../assets/portrait-frontier.jpg";
import Base from "../layouts/BaseLayout.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { site } from "../data/site";
import {
  research,
  internships,
  education,
  honors,
  service,
} from "../data/experience";
---

<Base title="About" description={site.about}>
  <div class="page-heading">
    <h1>
      About<span class="accent">.</span>
    </h1>
  </div>
  <section class="about-intro" aria-label="Introduction">
    <Image
      class="portrait"
      src={portrait}
      alt="Ritvik Prabhu beside the Frontier supercomputer at Oak Ridge National Laboratory"
      widths={[230, 460]}
      sizes="(max-width: 480px) 180px, (max-width: 760px) 150px, 230px"
      width={460}
      height={460}
      loading="eager"
    />
    <div class="about-copy">
      <p>{site.about}</p>
      <ProfileLinks />
    </div>
  </section>
  <nav class="about-sections" aria-label="About sections">
    <a href="#education">Education</a>
    <a href="#research">Research</a>
    <a href="#internships">Work experience</a>
    <a href="#awards">Awards & recognition</a>
    <a href="#service">Professional service</a>
  </nav>
  <section class="cv-section" aria-labelledby="education">
    <h2 id="education" tabindex="-1">
      Education
    </h2>
    <div>
      {education.map((entry) => (
        <article class="experience">
          <p class="dates">{entry.date}</p>
          <h3>{entry.degree}</h3>
          <p class="role">Virginia Tech</p>
          <p class="location">{site.location}</p>
          {entry.details && <p class="summary">{entry.details}</p>}
        </article>
      ))}
    </div>
  </section>
  {[
    { id: "research", title: "Research", entries: research },
    { id: "internships", title: "Work experience", entries: internships },
  ].map((section) => (
    <section class="cv-section" aria-labelledby={section.id}>
      <h2 id={section.id} tabindex="-1">
        {section.title}
      </h2>
      <div>
        {section.entries.map((entry) => (
          <article class="experience">
            <p class="dates">{entry.dates}</p>
            <h3>
              {entry.url ? (
                <a href={entry.url}>{entry.organization} ↗</a>
              ) : (
                entry.organization
              )}
            </h3>
            <p class="role">{entry.role}</p>
            <p class="location">{entry.location}</p>
            <p class="summary">{entry.summary}</p>
          </article>
        ))}
      </div>
    </section>
  ))}
  <section class="cv-section" aria-labelledby="awards">
    <h2 id="awards" tabindex="-1">
      Awards & recognition
    </h2>
    <div>
      {honors.map((entry) => (
        <article class="experience">
          {entry.date && <p class="dates">{entry.date}</p>}
          <h3>
            {entry.url ? <a href={entry.url}>{entry.title} ↗</a> : entry.title}
          </h3>
          <p class="summary">{entry.description}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="cv-section" aria-labelledby="service">
    <h2 id="service" tabindex="-1">
      Professional service
    </h2>
    <div>
      {service.map((entry) => (
        <article class="experience">
          <p class="dates">{entry.year}</p>
          <h3>{entry.role}</h3>
          <p class="role">{entry.venue}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
