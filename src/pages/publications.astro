---
import Base from "../layouts/BaseLayout.astro";
import Publication from "../components/Publication.astro";
import ContentFilters from "../components/ContentFilters.astro";
import { publications } from "../data/content";
const all = await publications();
const years = [...new Set(all.map((p) => p.data.year))];
---

<Base
  title="Publications"
  description="Publications by Ritvik Prabhu in high-performance computing, data systems, medical imaging, and interactive machine learning."
>
  <div class="page-heading listing-heading">
    <h1>
      Publications<span class="accent">.</span>
    </h1>
    <ContentFilters
      label="Search publications"
      placeholder="Title, author, venue or type"
      groupLabel="Publication type"
      options={["Conference", "Journal", "Workshop"]}
      count={all.length}
      noun="publication"
    />
  </div>
  <p class="filter-empty" hidden>
    No publications match. Try another search or type.
  </p>
  {years.map((year) => (
    <section
      class="year-group"
      data-filter-group
      aria-labelledby={`year-${year}`}
    >
      <h2 id={`year-${year}`}>{year}</h2>
      <div>
        {all
          .filter((p) => p.data.year === year)
          .map((publication) => (
            <Publication publication={publication} />
          ))}
      </div>
    </section>
  ))}
</Base>
