---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../../layouts/BaseLayout.astro";
import { writing, seriesPosts, date } from "../../../data/content";
export async function getStaticPaths() {
  return (await getCollection("series")).map((series) => ({
    params: { id: series.id },
    props: { series },
  }));
}
interface Props {
  series: CollectionEntry<"series">;
}
const { series } = Astro.props;
const posts = seriesPosts(series.id, await writing());
const data = series.data;
---

<Base title={data.title} description={data.description}>
  <div class="series-back">
    <a class="text-link" href="/writing/">
      ← The blog library
    </a>
  </div>
  <header class="series-hero">
    <div>
      <h1>
        {data.title}
        <span class="accent">.</span>
      </h1>
      <p class="series-deck">{data.description}</p>
    </div>
    <figure class="series-cover">
      <img src={data.cover} alt={data.coverAlt} width="1000" height="750" />
      {data.coverCaption && <figcaption>{data.coverCaption}</figcaption>}
    </figure>
  </header>
  {posts.length > 0 ? (
    <section aria-labelledby="series-posts-title">
      <div class="series-section-heading">
        <h2 id="series-posts-title">Posts</h2>
      </div>
      <ol class="series-posts">
        {posts.map((post, index) => (
          <li>
            <a class="series-post-card" href={`/writing/${post.id}/`}>
              <span class="chapter-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <time datetime={post.data.published.toISOString()}>
                  {date(post.data.published)}
                </time>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="card-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ) : (
    <section class="series-empty" aria-labelledby="series-empty-title">
      <h2 id="series-empty-title">No posts published yet.</h2>
      <a href="/rss.xml">Follow via RSS ↗</a>
    </section>
  )}
</Base>
