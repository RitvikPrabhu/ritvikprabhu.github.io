---
import Base from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import ContentFilters from "../../components/ContentFilters.astro";
import SeriesLibrary from "../../components/SeriesLibrary.astro";
import { writing } from "../../data/content";
const posts = (await writing()).filter((post) => post.data.series);
---

<Base
  title="Blog"
  description="Technical and research writing by Ritvik Prabhu."
>
  <div class="page-heading listing-heading">
    <h1>
      Blog<span class="accent">.</span>
    </h1>
  </div>
  <ContentFilters
    label="Search articles"
    placeholder="Title, description, topic or series"
    groupLabel="Article search"
    options={[]}
    count={posts.length}
    noun="article"
    searchOnly
  />
  <section data-search-results hidden aria-label="Article search results">
    <p class="filter-empty" hidden>
      No published articles match your search.
    </p>
    <PostList posts={posts} filterable />
  </section>
  <SeriesLibrary />
  <p class="series-subscribe">
    New chapters will appear here when ready.{" "}
    <a href="/rss.xml">Follow via RSS ↗</a>
  </p>
</Base>
