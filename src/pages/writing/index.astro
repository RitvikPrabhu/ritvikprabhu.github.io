---
import Base from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import ContentFilters from "../../components/ContentFilters.astro";
import SeriesLibrary from "../../components/SeriesLibrary.astro";
import { writing } from "../../data/content";
const posts = await writing();
const standalone = posts.filter((p) => !p.data.series);
const years = [
  ...new Set(standalone.map((p) => p.data.published.getUTCFullYear())),
];
const tags = [...new Set(standalone.flatMap((p) => p.data.tags))].sort();
---

<Base
  title="Blog"
  description="Technical and research writing by Ritvik Prabhu."
>
  <div class="page-heading listing-heading">
    <h1>
      Blog<span class="accent">.</span>
    </h1>
  </div>
  <SeriesLibrary posts={posts} />
  {standalone.length > 0 && (
    <section aria-labelledby="all-posts-title">
      <h2 id="all-posts-title">Standalone posts</h2>
      <ContentFilters
        label="Search posts"
        placeholder="Title, description or topic"
        groupLabel="Blog topics"
        options={tags}
        count={standalone.length}
        noun="post"
      />
      <p class="filter-empty" hidden>
        No posts match. Try another search or topic.
      </p>
      {years.map((year) => (
        <section class="year-group" data-filter-group>
          <h2>{year}</h2>
          <PostList
            filterable
            posts={standalone.filter(
              (p) => p.data.published.getUTCFullYear() === year,
            )}
          />
        </section>
      ))}
    </section>
  )}
  <p class="series-subscribe">
    New chapters will appear here when ready.{" "}
    <a href="/rss.xml">Follow via RSS ↗</a>
  </p>
</Base>
