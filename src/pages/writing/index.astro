---
import Base from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import ContentFilters from "../../components/ContentFilters.astro";
import { writing } from "../../data/content";
const posts = await writing();
const years = [...new Set(posts.map((p) => p.data.published.getUTCFullYear()))];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base
  title="Blog"
  description="Technical and research writing by Ritvik Prabhu."
>
  <div class="page-heading listing-heading">
    <h1>
      Blog<span class="accent">.</span>
    </h1>
    <ContentFilters
      label="Search posts"
      placeholder="Title, description or topic"
      groupLabel="Blog topics"
      options={tags}
      count={posts.length}
      noun="post"
    />
  </div>
  <p class="filter-empty" hidden>
    No posts match. Try another search or topic.
  </p>
  {posts.length ? (
    years.map((year) => (
      <section class="year-group" data-filter-group>
        <h2>{year}</h2>
        <PostList
          filterable
          posts={posts.filter(
            (p) => p.data.published.getUTCFullYear() === year,
          )}
        />
      </section>
    ))
  ) : (
    <div class="writing-empty">
      <p>No articles published yet.</p>
      <p>
        In the meantime, you can browse my{" "}
        <a href="/publications/">publications</a> or subscribe to the{" "}
        <a href="/rss.xml">RSS feed</a>.
      </p>
    </div>
  )}
</Base>
