---
import Base from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { writing } from "../../data/content";
const posts = await writing();
const years = [...new Set(posts.map((p) => p.data.published.getUTCFullYear()))];
---

<Base
  title="Writing"
  description="Technical and research writing by Ritvik Prabhu."
>
  <div class="page-heading">
    <p class="eyebrow">The blog</p>
    <h1>
      Writing<span class="accent">.</span>
    </h1>
    <p>
      Technical and research writing, with room to work through the details.
    </p>
  </div>
  {posts.length ? (
    years.map((year) => (
      <section class="year-group">
        <h2>{year}</h2>
        <PostList
          posts={posts.filter(
            (p) => p.data.published.getUTCFullYear() === year,
          )}
        />
      </section>
    ))
  ) : (
    <div class="writing-empty">
      <h2>A little space for longer thoughts.</h2>
      <p>No articles published yet.</p>
      <p>
        In the meantime, you can browse my{" "}
        <a href="/publications/">publications</a> or subscribe to the{" "}
        <a href="/rss.xml">RSS feed</a>.
      </p>
    </div>
  )}
  <aside class="example-note">
    <span>Site example</span>
    <p>
      <a href="/writing/example/">An article format reference →</a>
      <br />A demonstration of the blog’s typography and features—not a research
      post by Ritvik.
    </p>
  </aside>
</Base>
