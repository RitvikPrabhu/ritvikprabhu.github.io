---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Base from "./BaseLayout.astro";
import { date } from "../data/content";
import "katex/dist/katex.min.css";
interface Props {
  post: CollectionEntry<"writing">;
  headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const p = post.data;
const toc = headings.filter((h) => h.depth === 2);
---

<Base
  title={p.title}
  description={p.description}
  article
  published={p.published}
  updated={p.updated}
  noindex={p.example}
>
  <article class="article-wrap">
    <a class="text-link" href="/writing/">
      ← All posts
    </a>
    <header class="article-heading">
      {p.example && <p class="eyebrow">Example · Not a research article</p>}
      <h1>{p.title}</h1>
      <p class="article-description">{p.description}</p>
      <p class="article-meta">
        <time datetime={p.published.toISOString()}>{date(p.published)}</time>
        {p.updated && (
          <>
            {" "}
            · Updated{" "}
            <time datetime={p.updated.toISOString()}>{date(p.updated)}</time>
          </>
        )}
        {p.tags.length > 0 && <span> · {p.tags.join(", ")}</span>}
      </p>
    </header>
    {p.example && (
      <aside class="notice">
        This is an implementation example, not writing attributed to Ritvik. It
        is excluded from the homepage, RSS feed, search indexing, and sitemap.
      </aside>
    )}
    {toc.length >= 4 && (
      <nav class="toc" aria-label="Table of contents">
        <h2>On this page</h2>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
